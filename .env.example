# Copy this file to .env at the repo root (one file for backend and frontend).
# Never commit the real .env.

# ===== backend =====
NODE_ENV=development
PORT=3000
CLIENT_URL=http://localhost:5173

DATABASE_URL=

JWT_SECRET=
JWT_EXPIRES_IN=7d
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback

MAPBOX_TOKEN=

NASA_FIRMS_MAP_KEY=
FIRMS_SOURCE=VIIRS_NOAA20_NRT
N2YO_API_KEY=
OPENAQ_API_KEY=
ASTRONOMY_API_ID=
ASTRONOMY_API_SECRET=

NWS_USER_AGENT=Vantage (your-contact-email)

CACHE_DRIVER=memory
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ===== frontend (Vite only exposes VITE_* to the browser) =====
VITE_API_URL=http://localhost:3000/api
VITE_MAPBOX_TOKEN=